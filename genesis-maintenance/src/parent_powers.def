/*
 * Reference-derived INVENTORY, not a completed or playable power catalogue.
 * D=Deluxe, E=Ethereal Mists, L=GWLow5, U=UMGW, V=The Vortex, M=Mindcloud,
 * G=conservative original Genesis implementation (not a verbatim reference port).
 * Keys are parent-scoped and stable. Aliases/repeated sources are deduplicated.
 * Systems remain inventory entries, not additional gameplay-selection slots.
 * Entries remain unimplemented until real effects and tests exist.
 */
#define C(id, key, name, kind, dependencies, cost, humanity) I(CYBORG, key, name, kind, "V G")
#include "cyborg_components.def"
#undef C
